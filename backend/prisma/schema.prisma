
generator client {
  provider = "prisma-client-js"
}

// -------------------- ENUMS --------------------

enum UserRole {
  SALESMAN
  ADMIN
  PRODUCTION_SUPERVISOR
  ACCOUNTANT
  OWNER
}

enum CustomerType {
  RETAILER
  DISTRIBUTOR
}

enum MeasurementUnit {
  KG
  LITRE
  PIECE
}

enum StockItemType {
  RAW_MATERIAL
  FINISHED_PRODUCT
}

enum StockMovementType {
  OPENING
  PURCHASE
  PRODUCTION_ISSUE
  PRODUCTION_OUTPUT
  DISPATCH
  ADJUSTMENT
}

enum ProductionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SalesOrderStatus {
  PENDING
  APPROVED
  REJECTED
  PARTIALLY_DISPATCHED
  DISPATCHED
}

enum GSTType {
  INTRA_STATE
  INTER_STATE
}

enum InvoiceStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
}

// -------------------- USER MANAGEMENT --------------------

model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  password       String
  role           UserRole
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  salesOrders    SalesOrder[] @relation("SalesOrderCreatedBy")
  approvedOrders SalesOrder[] @relation("SalesOrderApprovedBy")
}

// -------------------- PRODUCT MASTER --------------------

model Product {
  id              String   @id @default(uuid())
  sku             String   @unique
  name            String
  packSizeGrams   Int
  sellingPrice    Decimal  @db.Decimal(12, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bom             BOM?
  salesOrderItems SalesOrderItem[]
  dispatchItems   DispatchItem[]
}

// -------------------- CUSTOMER MASTER --------------------

model Customer {
  id           String       @id @default(uuid())
  customerCode String       @unique
  name         String
  customerType CustomerType
  gstin        String?      @unique
  state        String
  stateCode    String
  address      String
  phone        String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  salesOrders  SalesOrder[]
}

// -------------------- RAW MATERIAL MASTER --------------------

model RawMaterial {
  id                       String          @id @default(uuid())
  materialCode             String          @unique
  name                     String
  unit                     MeasurementUnit
  reorderLevel             Decimal         @default(0) @db.Decimal(12, 3)
  isActive                 Boolean         @default(true)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  bomItems                 BOMItem[]
  purchaseItems            PurchaseItem[]
  productionConsumptions   ProductionConsumption[]
}

// -------------------- BILL OF MATERIALS --------------------

model BOM {
  id                  String   @id @default(uuid())
  productId           String   @unique
  batchOutputPackets  Int
  version             Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  product             Product  @relation(fields: [productId], references: [id])
  items               BOMItem[]
  productionRuns      ProductionRun[]
}

model BOMItem {
  id             String       @id @default(uuid())
  bomId          String
  rawMaterialId  String
  quantity       Decimal      @db.Decimal(12, 3)

  bom            BOM          @relation(fields: [bomId], references: [id], onDelete: Cascade)
  rawMaterial    RawMaterial  @relation(fields: [rawMaterialId], references: [id])

  @@unique([bomId, rawMaterialId])
}

// -------------------- INVENTORY MANAGEMENT --------------------

model StockBalance {
  id          String        @id @default(uuid())
  itemType    StockItemType
  itemId      String
  quantity    Decimal       @default(0) @db.Decimal(14, 3)
  updatedAt   DateTime      @updatedAt

  @@unique([itemType, itemId])
}

model StockMovement {
  id             String            @id @default(uuid())
  itemType       StockItemType
  itemId         String
  movementType   StockMovementType
  quantity       Decimal           @db.Decimal(14, 3)
  referenceId    String?
  description    String?
  createdAt      DateTime          @default(now())
  createdBy      String?
}

// -------------------- PURCHASE MANAGEMENT --------------------

model Purchase {
  id             String         @id @default(uuid())
  purchaseNumber String         @unique
  supplierName   String
  invoiceNumber  String?
  purchaseDate   DateTime       @default(now())
  totalAmount    Decimal        @db.Decimal(14, 2)
  createdAt      DateTime       @default(now())

  items          PurchaseItem[]
}

model PurchaseItem {
  id             String       @id @default(uuid())
  purchaseId     String
  rawMaterialId  String
  quantity       Decimal      @db.Decimal(14, 3)
  unitPrice      Decimal      @db.Decimal(12, 2)
  totalPrice     Decimal      @db.Decimal(14, 2)

  purchase       Purchase     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  rawMaterial    RawMaterial  @relation(fields: [rawMaterialId], references: [id])
}

// -------------------- PRODUCTION MANAGEMENT --------------------

model ProductionRun {
  id                 String           @id @default(uuid())
  batchNumber        String           @unique
  bomId              String
  plannedOutput      Int
  actualGoodOutput   Int              @default(0)
  damagedPouches     Int              @default(0)
  cartonsUsed        Decimal          @default(0) @db.Decimal(12, 3)
  labourCost         Decimal          @default(0) @db.Decimal(14, 2)
  powerCost          Decimal          @default(0) @db.Decimal(14, 2)
  status             ProductionStatus @default(PLANNED)
  productionDate     DateTime         @default(now())
  createdAt          DateTime         @default(now())

  bom                BOM              @relation(fields: [bomId], references: [id])
  consumptions       ProductionConsumption[]
}

model ProductionConsumption {
  id                 String       @id @default(uuid())
  productionRunId    String
  rawMaterialId      String
  plannedQuantity    Decimal      @db.Decimal(14, 3)
  actualQuantity     Decimal      @db.Decimal(14, 3)

  productionRun      ProductionRun @relation(fields: [productionRunId], references: [id], onDelete: Cascade)
  rawMaterial        RawMaterial   @relation(fields: [rawMaterialId], references: [id])
}

// -------------------- SALES ORDER MANAGEMENT --------------------

model SalesOrder {
  id             String           @id @default(uuid())
  orderNumber    String           @unique
  customerId     String
  salesmanId     String
  approvedById   String?
  status         SalesOrderStatus @default(PENDING)
  orderDate      DateTime         @default(now())
  approvedAt     DateTime?
  createdAt      DateTime         @default(now())

  customer       Customer         @relation(fields: [customerId], references: [id])
  salesman       User             @relation("SalesOrderCreatedBy", fields: [salesmanId], references: [id])
  approvedBy     User?            @relation("SalesOrderApprovedBy", fields: [approvedById], references: [id])
  items          SalesOrderItem[]
  invoice        Invoice?
  dispatches     Dispatch[]
}

model SalesOrderItem {
  id             String     @id @default(uuid())
  salesOrderId   String
  productId      String
  quantity       Int
  unitPrice      Decimal    @db.Decimal(12, 2)

  salesOrder     SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product        Product    @relation(fields: [productId], references: [id])
}

// -------------------- GST INVOICING --------------------

model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique
  salesOrderId    String        @unique
  gstType         GSTType
  taxableAmount   Decimal       @db.Decimal(14, 2)
  cgst            Decimal       @default(0) @db.Decimal(14, 2)
  sgst            Decimal       @default(0) @db.Decimal(14, 2)
  igst            Decimal       @default(0) @db.Decimal(14, 2)
  totalAmount     Decimal       @db.Decimal(14, 2)
  status          InvoiceStatus @default(ISSUED)
  invoiceDate     DateTime      @default(now())

  salesOrder      SalesOrder    @relation(fields: [salesOrderId], references: [id])
  payments        Payment[]
}

// -------------------- DISPATCH MANAGEMENT --------------------

model Dispatch {
  id              String      @id @default(uuid())
  dispatchNumber  String      @unique
  salesOrderId    String
  dispatchDate    DateTime    @default(now())
  notes           String?

  salesOrder      SalesOrder  @relation(fields: [salesOrderId], references: [id])
  items           DispatchItem[]
}

model DispatchItem {
  id              String    @id @default(uuid())
  dispatchId      String
  productId       String
  quantity        Int

  dispatch        Dispatch  @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  product         Product   @relation(fields: [productId], references: [id])
}

// -------------------- PAYMENT MANAGEMENT --------------------

model Payment {
  id              String   @id @default(uuid())
  invoiceId       String
  amount          Decimal  @db.Decimal(14, 2)
  paymentMethod   String
  referenceNumber String?
  paymentDate     DateTime @default(now())

  invoice         Invoice  @relation(fields: [invoiceId], references: [id])
}
datasource db {
  provider = "postgresql"
}